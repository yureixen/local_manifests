<?xml version="1.0" encoding="UTF-8"?>

<manifest>

  <remote name="yureixen" fetch="https://github.com/yureixen/" />
  <remote name="los" fetch="https://github.com/LineageOS/" />

  <!-- Device tree -->
  <project path="device/xiaomi/onclite"
           name="android_device_xiaomi_onclite"
           remote="yureixen"
           revision="lineage-20"
           clone-depth="1" />

  <!-- Vendor blobs -->
  <project path="vendor/xiaomi/onclite"
           name="proprietary_vendor_xiaomi_onclite"
           remote="yureixen"
           revision="lineage-20"
           clone-depth="1" />

  <!-- Kernel source -->
  <project path="kernel/xiaomi/onclite"
           name="android_kernel_xiaomi_onclite"
           remote="yureixen"
           revision="lineage-20"
           clone-depth="1" />

  <!-- Xiaomi hardware/HAL-->
  <project path="hardware/xiaomi"
           name="android_hardware_xiaomi"
           remote="los"
           revision="lineage-20"
           clone-depth="1" />

</manifest>
