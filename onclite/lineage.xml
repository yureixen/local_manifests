<manifest>

  <remote name="cbh" fetch="https://codeberg.org/hadad/" />
  <remote name="los" fetch="https://github.com/LineageOS/" />
  <remote name="onclite" fetch="https://github.com/onclite/" />

  <!-- Device tree -->
  <project path="device/xiaomi/onclite"
           name="android_device_xiaomi_onclite"
           remote="cbh"
           revision="lineage-23.2"
           clone-depth="1" />
     
  <!-- Vendor blobs -->
  <project path="vendor/xiaomi/onclite"
           name="android_vendor_xiaomi_onclite"
           remote="cbh"
           revision="lineage-23.2"
           clone-depth="1" />
     
  <!-- Kernel source -->
  <project path="kernel/xiaomi/onclite"
           name="android_kernel_xiaomi_onclite"
           remote="cbh"
           revision="lineage-23.2"
           clone-depth="1" />
     
  <!-- Xiaomi hardware/HAL -->
  <project path="hardware/xiaomi"
           name="android_hardware_xiaomi"
           remote="los"
           revision="lineage-23.2"
           clone-depth="1" />

  <!-- Proton Clang -->
  <project path="prebuilts/clang/kernel/linux-x86/clang-proton"
           name="proton-clang"
           remote="onclite"
           revision="20210123" />

</manifest>
